      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ffmpeg not found — subtitle burn-in unavailable"
          }
        }
      }
    },
    "未检测到内置电池（台式机/无电池机型）": {
      "extractionState": "manual",
      "localizations": {
