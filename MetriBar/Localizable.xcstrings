            "state": "translated",
            "value": "Translation service running"
          }
        }
      }
    },
    "联动": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wired"
          }
        }
      }
    },
    "肤色/天空/植被参照色卡。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference patches for skin, sky and foliage."
          }
        }
      }
    },
    "胶囊底": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pill background"
          }
        }
      }
    },
    "能清楚听到自己的声音 = 麦克风正常；无声/断续 = 异常": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hearing your own voice clearly means the microphone is fine; silence or dropouts mean a fault."
          }
        }
      }
    },
    "自动": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic"
          }
        }
      }
    },
    "色彩还原": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color accuracy"
          }
        }
      }
    },
    "菜单栏显示": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu bar display"
          }
        }
      }
    },
    "蓝": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blue"
          }
        }
      }
    },
    "蓝牙未开启": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth off"
          }
        }
      }
    },
    "被按下的键应实时点亮并计数；未点亮的键即为不触发。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every key you press should light up and be counted in real time; a key that never lights up does not register."
          }
        }
      }
    },
    "覆盖四个角与边缘，检查是否存在无响应区域。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover all four corners and the edges to check for areas that do not respond."
          }
        }
      }
    },
    "观察充电头与接口有无烧灼、发黑痕迹。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the connector and the port for burn marks or blackening."
          }
        }
      }
    },
    "观察是否出现黑斑、水波纹样扩散。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch for dark spots or ripples that spread like water."
          }
        }
      }
    },
    "视频翻译": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video Translation"
          }
        }
      }
    },
    "角标/十字/斜线检查进纸歪斜。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Corner marks, crosses and diagonals for paper skew."
          }
        }
      }
    },
    "触控板全域画布": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-area trackpad canvas"
          }
        }
      }
    },
    "触控板检测": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad test"
          }
        }
      }
    },
    "触摸机身底部与键盘上方，温度应均匀上升而非局部烫手。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feel the bottom case and the area above the keyboard; heat should be even rather than burning hot in one spot."
          }
        }
      }
    },
    "让卖家当面执行「抹掉所有内容和设置」，重启进入设置助理。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have the seller erase all content and settings in front of you, then restart into Setup Assistant."
          }
        }
      }
    },
    "记录序列号：清晰拍摄盒上序列号，开箱后与机身序列号对比——必须完全一致。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record the serial number: film the serial number on the box clearly, then compare it with the serial number on the machine after unboxing — they must match exactly."
          }
        }
      }
    },
    "设备": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device"
          }
        }
      }
    },
    "设备名过滤（留空=任意心率设备）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device name filter (empty = any heart-rate device)"
          }
        }
      }
    },
    "设备被其他 App 占用或输入不可用": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app is using the device, or the input is unavailable."
          }
        }
      }
    },
    "设备：%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device: %@"
          }
        }
      }
    },
    "设置助理若仍要求输入前机主 Apple 账户密码 = 激活锁未解除，绝对不能付款。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Setup Assistant still asks for the previous owner's Apple Account password, Activation Lock has not been removed and you must not pay."
          }
        }
      }
    },
    "设置（⌘,）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings (⌘,)"
          }
        }
      }
    },
    "诊断模式（ADP000）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics mode (ADP000)"
          }
        }
      }
    },
    "该入口只在检测到维修时显示；没有入口一般说明无维修记录。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This section appears only when a repair is detected; if it is missing, there is usually no service history."
          }
        }
      }
    },
    "该机型或系统未提供可用摄像头设备": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model or macOS provides no available camera device."
          }
        }
      }
    },
    "该机型或系统未提供输入设备": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model or macOS provides no input device."
          }
        }
      }
    },
    "该目录下未发现任何模型（共查 %ld 个）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No models found in this directory (checked %ld)."
          }
        }
      }
    },
    "详细日志": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detailed log"
          }
        }
      }
    },
    "语音识别中…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribing…"
          }
        }
      }
    },
    "请先在右侧「一键构建环境」": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build the environment first (button on the right)"
          }
        }
      }
    },
    "请在手表开启「广播心率」并允许蓝牙": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Broadcast Heart Rate” on your watch and allow Bluetooth"
          }
        }
      }
    },
    "请在系统设置允许蓝牙": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Bluetooth in System Settings"
          }
        }
      }
    },
    "请正常说话，录音结束会自动播放给你听": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak normally; the recording plays back automatically when it ends."
          }
        }
      }
    },
    "读取失败": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read failed"
          }
        }
      }
    },
    "谨慎抹掉内置磁盘：在恢复模式打开「磁盘工具」，选 Macintosh HD；若有「抹掉卷组」优先用它，否则点「抹掉」并保持 APFS 格式。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase the internal disk carefully: open Disk Utility in Recovery mode and select Macintosh HD; if Erase Volume Group is offered, use it, otherwise click Erase and keep the APFS format."
          }
        }
      }
    },
    "跑 2 分钟高负载（编译、跑分或视频导出）。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run a two-minute high load (compiling, benchmarking, or exporting video)."
          }
        }
      }
    },
    "路径无效（需已存在的文件夹）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid path (must be an existing folder)"
          }
        }
      }
    },
    "转写 → 翻译 → 双语字幕（可选烧录）。\n多路并行处理；模型用完自动卸载。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription → translation → bilingual subtitles (burn-in optional).\nParallel processing; models unload when done."
          }
        }
      }
    },
    "转写中": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribing"
          }
        }
      }
    },
    "转写环境已就绪": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription environment ready"
          }
        }
      }
    },
    "轻微均匀的边缘泛光属正常；局部喷溅状亮斑属异常。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Faint, even glow along the edges is normal; localized splash-shaped bright patches are not."
          }
        }
      }
    },
    "轻擦屏幕，查看防反射镀膜是否脱落（2012–2019 款高发）。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wipe the display lightly and check whether the anti-reflective coating is peeling (common on 2012–2019 models)."
          }
        }
      }
    },
    "轻轻碰动线缆，充电不应中断。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nudge the cable gently; charging should not stop."
          }
        }
      }
    },
    "输入序列号，核对显示的机型、购买日期与保修/AppleCare 状态是否与卖家描述一致。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the serial number and confirm that the model, purchase date, and warranty or AppleCare status match what the seller described."
          }
        }
      }
    },
    "输入设备": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input devices"
          }
        }
      }
    },
    "运动流畅度测试：方块应平滑移动，卡顿说明掉帧；滚动线条应平滑无撕裂或抖动。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the motion smoothness test, the squares should move smoothly — stuttering means dropped frames — and the scrolling lines should be smooth with no tearing or judder."
          }
        }
      }
    },
    "运行时与依赖": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime & dependencies"
          }
        }
      }
    },
    "运行时与模型": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime & models"
          }
        }
      }
    },
    "这个验机工具要收费或安装软件吗？": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does this inspection tool cost money or require installing software?"
          }
        }
      }
    },
    "进水指示器检测": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Contact Indicator (LCI) check"
          }
        }
      }
    },
    "连 Wi-Fi 看信号并测速，蓝牙配对设备验证。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join a Wi-Fi network to check signal and speed, and pair a Bluetooth device to verify it."
          }
        }
      }
    },
    "连接 Wi-Fi，检查信号强度与实测网速是否正常。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to Wi-Fi and check that signal strength and measured speed are normal."
          }
        }
      }
    },
    "连接中…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting…"
          }
        }
      }
    },
    "连接状态": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection"
          }
        }
      }
    },
    "连接蓝牙耳机或键鼠，确认配对与音频/输入正常。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Bluetooth headphones or a keyboard and mouse and confirm that pairing, audio, and input work."
          }
        }
      }
    },
