            "value": "Celsius (°C)"
          }
        }
      }
    },
    "播放一段熟悉的音乐，注意是否有共振、金属杂音。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a piece of music you know well and listen for resonance or metallic rattling."
          }
        }
      }
    },
    "播放高质量音视频素材，检查音质、音量与画面色彩。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play high-quality audio and video material and check sound quality, volume, and color."
          }
        }
      }
    },
    "操作步骤 %ld 步": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%ld steps"
          }
        }
      }
    },
    "文字、线条、几何与对比度总检。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overall check of text, lines, geometry and contrast."
          }
        }
      }
    },
    "文字清晰度": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text clarity"
          }
        }
      }
    },
    "斜角光线下观察是否有彩虹纹、起皮、脱落斑块。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the display under angled light for rainbow marks, flaking, or patches where the coating has come off."
          }
        }
      }
    },
