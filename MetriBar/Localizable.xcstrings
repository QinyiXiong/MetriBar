          "stringUnit": {
            "state": "translated",
            "value": "Quit MetriBar"
          }
        }
      }
    },
    "选择并扫描": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select & Scan"
          }
        }
      }
    },
    "选择模型文件夹（内含 SenseVoiceSmall 等子目录）· ⌘⇧. 可显示隐藏文件夹": {
      "extractionState": "manual",
      "localizations": {
