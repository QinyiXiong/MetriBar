    "未安装 ffmpeg，无法烧录字幕。请在终端执行：brew install ffmpeg（或取消勾选「烧录字幕进视频」）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ffmpeg not installed — cannot burn in subtitles. Run this in Terminal: brew install ffmpeg (or uncheck \"Burn subtitles into video\")"
          }
        }
      }
    },
