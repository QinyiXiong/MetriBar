            "value": "No background"
          }
        }
      }
    },
    "日志": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log"
          }
        }
      }
    },
    "显示器": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display"
          }
        }
      }
    },
    "暂停": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        }
      }
    },
    "暗环境下纯黑画面、亮度拉满，检查四边四角是否漏光。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a dark room with a pure black screen at maximum brightness, check the edges and corners for light leaks."
          }
        }
      }
    },
    "更可靠的方法：抹机后联网进入设置助理，若出现「远程管理」页面即为企业注册机。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a more reliable check, erase the Mac and go through Setup Assistant while online; a Remote Management page means it is enrolled by a company."
          }
        }
      }
    },
    "更早机型：看 True Tone 原彩显示与自动亮度是否可用——本应支持却没有，通常是非原装屏。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On earlier models, check whether True Tone and auto-brightness work — if the model should support them but they are missing, the display is usually not original."
          }
        }
      }
    },
    "最低系统": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum OS"
          }
        }
      }
    },
    "最后一步：抹掉重装系统（最后做）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Final step: Erase and reinstall macOS (do this last)"
